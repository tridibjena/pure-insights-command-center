# ── PostgreSQL (docker-compose maps container 5432 → host PGPORT) ───────────
PGHOST=localhost
PGPORT=5433
PGUSER=pic
PGPASSWORD=pic_dev_password
PGDATABASE=pure_insights
PGDATABASE_TEST=pure_insights_test

# ── API server ──────────────────────────────────────────────────────────────
API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Generate a real secret for anything beyond local dev: openssl rand -hex 32
JWT_SECRET=change-me-local-dev-only-secret-0123456789abcdef
SESSION_TTL_HOURS=8
# Shared key for machine-to-machine telemetry ingestion (SERVICE role)
TELEMETRY_API_KEY=pic-dev-telemetry-key
# Password given to the seeded demo accounts
SEED_DEMO_PASSWORD=PureInsights!2026

# ── Alerting (Task 2) ───────────────────────────────────────────────────────
# Alert threshold from the brief: load latency strictly greater than 15 s.
LATENCY_ALERT_THRESHOLD_SEC=15
# Display severity tiers above the threshold (configurable, not from the brief)
LATENCY_HIGH_ABOVE_SEC=30
LATENCY_CRITICAL_ABOVE_SEC=45
# Data-validity guard: latency at or below 0 or above this is bad data, not an alert
LATENCY_INVALID_ABOVE_SEC=300

# ── Telemetry replay (streams the 20 CSV snapshots as live events) ─────────
REPLAY_AUTOSTART=false
REPLAY_SNAPSHOT_INTERVAL_MS=10000
REPLAY_LOOP=false

# ── Cost model (Task 3) ─────────────────────────────────────────────────────
# Snowflake price per credit in USD (not in the dataset; documented assumption)
CREDIT_PRICE_USD=3.00
